/* Stanford Perm, ported from LLVM test-suite SingleSource/Benchmarks/Stanford.
   Denny Brown's recursive permutation generator: each run makes 43300
   calls. Ten runs instead of a hundred; -1 stands in for the error message. */
int permarray[11];
int pctr;

void swap(int i, int j)
{ int t;
  t = permarray[i];
  permarray[i] = permarray[j];
  permarray[j] = t;
}

void initialize(void)
{ int i;
  i = 1;
  while (i <= 7)
    { permarray[i] = i - 1;
      i = i + 1; }
}

void permute(int n)
{ int k;
  pctr = pctr + 1;
  if (n != 1)
    { permute(n - 1);
      k = n - 1;
      while (k >= 1)
        { swap(n, k);
          permute(n - 1);
          swap(n, k);
          k = k - 1; } }
}

void perm(void)
{ int i;
  pctr = 0;
  i = 1;
  while (i <= 5)
    { initialize();
      permute(7);
      i = i + 1; }
  if (pctr != 43300) output(0 - 1);
  output(pctr);
}

void main(void)
{ int i;
  i = 0;
  while (i < 10)
    { perm();
      i = i + 1; }
}
