/* Precedence, associativity, integer division and the relational operators. */
void main(void)
{ int a; int b;
  a = 7; b = 2;
  output(a + b);          /* 9  */
  output(a - b);          /* 5  */
  output(a * b);          /* 14 */
  output(a / b);          /* 3  -- integer division */
  output(0 - a);          /* -7 -- C- has no unary minus */
  output((0 - a) / b);    /* -3 -- truncates toward zero */
  output(a - a / b * b);  /* 1  -- a mod b */
  output(a < b);          /* 0  -- a comparison is 1 or 0 */
  output(a > b);          /* 1  */
  output(a == 7);         /* 1  */
  output(a != 7);         /* 0  */
  output(a <= 7);         /* 1  */
  output(a >= 8);         /* 0  */
}
