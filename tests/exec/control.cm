void main(void)
{ int i; int j; int n;
  n = 0;
  i = 0;
  while (i < 3)
    { j = 0;
      while (j < 3)
        { if (i == j) n = n + 10;
          else if (i < j) n = n + 1;
          j = j + 1; }
      i = i + 1; }
  output(n);
  if (0) output(1); else output(2);
  while (0) output(3);
  output(4);
}
