/* nsieve-bits, ported from LLVM test-suite SingleSource/Benchmarks/BenchmarkGame
   (Mike Pall's entry in the Computer Language Shootout). Counts the primes up
   to n, n/2 and n/4 with a sieve; the bit array becomes one int per number.
   n is 40000 instead of 10000 << 12. */
int primes[40001];

void main(void)
{ int m;
  int n;
  int i;
  int j;
  int count;
  n = 40000;
  m = 0;
  while (m <= 2)
    { i = 0;
      while (i <= n)
        { primes[i] = 1;
          i = i + 1; }
      count = 0;
      i = 2;
      while (i <= n)
        { if (primes[i])
            { count = count + 1;
              j = i + i;
              while (j <= n)
                { if (primes[j]) primes[j] = 0;
                  j = j + i; } }
          i = i + 1; }
      output(n);
      output(count);
      n = n / 2;
      m = m + 1; }
}
