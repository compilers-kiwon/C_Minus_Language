/* matrix, ported from LLVM test-suite SingleSource/Benchmarks/Shootout (Doug
   Bagley's shootout). Multiplies two 10x10 matrices n times and prints four
   entries of the product; the malloc'd rows become flat arrays. n is 10
   instead of 3000000; the product does not depend on it. */
int ma[100];
int mb[100];
int mm[100];

void mkmatrix(int m[])
{ int i;
  int count;
  count = 1;
  i = 0;
  while (i < 100)
    { m[i] = count;
      count = count + 1;
      i = i + 1; }
}

void mmult(int a[], int b[], int c[])
{ int i;
  int j;
  int k;
  int sum;
  i = 0;
  while (i < 10)
    { j = 0;
      while (j < 10)
        { sum = 0;
          k = 0;
          while (k < 10)
            { sum = sum + a[i * 10 + k] * b[k * 10 + j];
              k = k + 1; }
          c[i * 10 + j] = sum;
          j = j + 1; }
      i = i + 1; }
}

void main(void)
{ int i;
  mkmatrix(ma);
  mkmatrix(mb);
  mkmatrix(mm);
  i = 0;
  while (i < 10)
    { mmult(ma, mb, mm);
      i = i + 1; }
  output(mm[0]);
  output(mm[23]);
  output(mm[32]);
  output(mm[44]);
}
