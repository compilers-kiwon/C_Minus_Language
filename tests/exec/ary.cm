/* ary3, ported from LLVM test-suite SingleSource/Benchmarks/Shootout (Doug
   Bagley's shootout, after Kernighan and Van Wyk). Adds one array into
   another a thousand times, walking backwards. n is 1000 instead of 1500000. */
int x[1000];
int y[1000];

void main(void)
{ int n;
  int i;
  int k;
  n = 1000;
  i = 0;
  while (i < n)
    { x[i] = i + 1;
      i = i + 1; }
  k = 0;
  while (k < 1000)
    { i = n - 1;
      while (i >= 0)
        { y[i] = y[i] + x[i];
          i = i - 1; }
      k = k + 1; }
  output(y[0]);
  output(y[n - 1]);
}
