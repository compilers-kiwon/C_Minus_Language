/* Stanford Quick, ported from LLVM test-suite SingleSource/Benchmarks/Stanford.
   Quicksorts 5000 pseudo-random integers; the do-while becomes a flag. Ten
   runs instead of a hundred; -1 stands in for the error message. */
int sortlist[5001];
int biggest;
int littlest;
int seed;

void initrand(void)
{ seed = 74755;
}

/* seed = (seed * 1309 + 13849) & 65535, with & 65535 as a remainder. */
int nextrand(void)
{ int s;
  s = seed * 1309 + 13849;
  seed = s - s / 65536 * 65536;
  return seed;
}

void initarr(void)
{ int i;
  int temp;
  initrand();
  biggest = 0;
  littlest = 0;
  i = 1;
  while (i <= 5000)
    { temp = nextrand();
      sortlist[i] = temp - (temp / 100000) * 100000 - 50000;
      if (sortlist[i] > biggest) biggest = sortlist[i];
      else if (sortlist[i] < littlest) littlest = sortlist[i];
      i = i + 1; }
}

void quicksort(int a[], int l, int r)
{ int i;
  int j;
  int x;
  int w;
  int again;
  i = l;
  j = r;
  x = a[(l + r) / 2];
  again = 1;
  while (again)
    { while (a[i] < x) i = i + 1;
      while (x < a[j]) j = j - 1;
      if (i <= j)
        { w = a[i];
          a[i] = a[j];
          a[j] = w;
          i = i + 1;
          j = j - 1; }
      again = i <= j; }
  if (l < j) quicksort(a, l, j);
  if (i < r) quicksort(a, i, r);
}

void quick(int run)
{ initarr();
  quicksort(sortlist, 1, 5000);
  if (sortlist[1] != littlest) output(0 - 1);
  else if (sortlist[5000] != biggest) output(0 - 1);
  output(sortlist[run + 1]);
}

void main(void)
{ int i;
  i = 0;
  while (i < 10)
    { quick(i);
      i = i + 1; }
}
